{
  "id": 5,
  "name": "图片编辑",
  "description": "根据参考图与文字说明编辑图片。",
  "preview": "上传参考图并填写编辑说明",
  "price": 20,
  "tags": [
    "image",
    "img2img",
    "edit"
  ],
  "categories": [
    "generate"
  ],
  "inputs": [
    {
      "key": "reference",
      "type": "image",
      "required": true,
      "description": "参考图 / 原图"
    },
    {
      "key": "prompt",
      "type": "string",
      "required": true,
      "description": "编辑说明"
    }
  ],
  "outputs": [
    {
      "key": "image",
      "type": "image"
    }
  ],
  "bindings": {
    "workflow": {
      "1": {
        "class_type": "UNETLoader",
        "inputs": {
          "unet_name": "flux2klein_v4_turbo_fp8.safetensors",
          "weight_dtype": "fp8_e4m3fn"
        }
      },
      "2": {
        "class_type": "CLIPLoader",
        "inputs": {
          "clip_name": "qwen_3_8b_fp8mixed.safetensors",
          "type": "flux2",
          "device": "default"
        }
      },
      "3": {
        "class_type": "VAELoader",
        "inputs": {
          "vae_name": "flux2-vae.safetensors"
        }
      },
      "10": {
        "class_type": "LoadImage",
        "inputs": {
          "image": "face_ref_01.png"
        }
      },
      "11": {
        "class_type": "ImageScale",
        "inputs": {
          "image": [
            "10",
            0
          ],
          "upscale_method": "lanczos",
          "width": 896,
          "height": 1152,
          "crop": "center"
        }
      },
      "14": {
        "class_type": "ImageScaleToTotalPixels",
        "inputs": {
          "image": [
            "11",
            0
          ],
          "upscale_method": "lanczos",
          "megapixels": 1.0,
          "resolution_steps": 1
        }
      },
      "13": {
        "class_type": "VAEEncode",
        "inputs": {
          "pixels": [
            "14",
            0
          ],
          "vae": [
            "3",
            0
          ]
        }
      },
      "20": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "clip": [
            "2",
            0
          ],
          "text": "把这张照片改成女孩子跪姿的场景，彻底改变姿势和构图，不要保留原图坐着的姿势。pov, 她跪在地上，衣服脱下裸露上半身，右手握着男性的阴茎，左手握住自己的乳房。阴茎必须是真实普通男性尺寸：短而正常，不要过长，不要夸张，不要巨大，不要占满画面前景。画面是第一人称视角，但用中近景：能清楚看到她的上半身、胸部和脸，不要脸部特写占满画面。男人不要露脸、不要出现上身，只看到他张开的大腿和普通大小的勃起阴茎。她半脱衣服，上衣被拉开或褪下，胸口和乳房露出，一只手抓着自己的乳房，另一只手扶着阴茎或大腿。保留同一个女孩的脸、五官、发型和身份。手部解剖正确：每只手只有五根手指，手指自然，没有多余手指、没有融合手指、没有畸形手。人体比例正确，不要夸张透视，前景物体不要放大。写实摄影，自然光影，清晰细节。"
        }
      },
      "21": {
        "class_type": "ConditioningZeroOut",
        "inputs": {
          "conditioning": [
            "20",
            0
          ]
        }
      },
      "22": {
        "class_type": "ReferenceLatent",
        "inputs": {
          "conditioning": [
            "20",
            0
          ],
          "latent": [
            "13",
            0
          ]
        }
      },
      "23": {
        "class_type": "ReferenceLatent",
        "inputs": {
          "conditioning": [
            "21",
            0
          ],
          "latent": [
            "13",
            0
          ]
        }
      },
      "30": {
        "class_type": "EmptyFlux2LatentImage",
        "inputs": {
          "width": 832,
          "height": 1216,
          "batch_size": 1
        }
      },
      "40": {
        "class_type": "KSampler",
        "inputs": {
          "model": [
            "1",
            0
          ],
          "positive": [
            "22",
            0
          ],
          "negative": [
            "23",
            0
          ],
          "latent_image": [
            "30",
            0
          ],
          "seed": 42,
          "steps": 8,
          "cfg": 1.0,
          "sampler_name": "euler",
          "scheduler": "simple",
          "denoise": 1.0
        }
      },
      "50": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "40",
            0
          ],
          "vae": [
            "3",
            0
          ]
        }
      },
      "60": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "50",
            0
          ],
          "filename_prefix": "Klein-Edit"
        }
      }
    },
    "inputs": [
      {
        "key": "reference",
        "node_id": "10",
        "field_path": "image"
      },
      {
        "key": "prompt",
        "node_id": "20",
        "field_path": "text"
      }
    ],
    "outputs": [
      {
        "key": "image",
        "node_id": "60",
        "index": 0
      }
    ]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reference",
      "prompt"
    ],
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        }
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
